{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OverlyPermissiveEC2AndPassRole",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RunInstances",
        "iam:PassRole"
      ],
      "Resource": "*"
    }
  ]
}