{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UnscopedAccessKeyManager",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:ListAccessKeys",
        "iam:GetUser"
      ],
      "Resource": "arn:aws:iam::123456789012:user/*"
    }
  ]
}