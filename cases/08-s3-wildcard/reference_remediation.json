{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StaticAssetsBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::app-static-assets-prod"
    },
    {
      "Sid": "StaticAssetsObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::app-static-assets-prod/*"
    }
  ]
}