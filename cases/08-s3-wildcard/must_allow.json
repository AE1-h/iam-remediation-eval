[
  {
    "description": "Static sync lists assets bucket",
    "action": "s3:ListBucket",
    "resource": "arn:aws:s3:::app-static-assets-prod"
  },
  {
    "description": "Static sync downloads assets for verification",
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::app-static-assets-prod/css/main.css"
  },
  {
    "description": "Static sync uploads new static asset build",
    "action": "s3:PutObject",
    "resource": "arn:aws:s3:::app-static-assets-prod/css/main.css"
  }
]