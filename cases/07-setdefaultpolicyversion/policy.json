{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PolicyInventoryCollector",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}